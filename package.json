{
  "name": "probatur",
  "version": "0.1.0",
  "description": "Probatur — open any PHP project (Core, Laravel, Symfony, CodeIgniter, WordPress, …) and inspect / lint / static-analyse / unit-test any file or folder from a Visual-Studio-style tree UI in the browser.",
  "license": "MIT",
  "author": "Vugar Familoglu",
  "type": "module",
  "scripts": {
    "build":     "tsc",
    "clean":     "rimraf dist",
    "start":     "node dist/server/index.js",
    "dev":       "tsc --watch",
    "lint:smoke":"node dist/server/index.js --smoke"
  },
  "engines": { "node": ">=18.0.0" },
  "dependencies": {
    "express":         "^4.19.2",
    "ws":              "^8.16.0",
    "mime-types":      "^2.1.35"
  },
  "devDependencies": {
    "@types/express":  "^4.17.21",
    "@types/node":     "^20.10.0",
    "@types/ws":       "^8.5.10",
    "@types/mime-types":"^2.1.4",
    "rimraf":          "^5.0.5",
    "typescript":      "^5.3.0"
  },
  "keywords": [
    "php", "phpunit", "phpstan", "psalm", "linter", "laravel", "symfony",
    "code-quality", "static-analysis", "test-runner"
  ]
}
