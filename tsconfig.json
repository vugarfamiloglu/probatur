{
  "compilerOptions": {
    "target":              "ES2022",
    "module":              "ES2022",
    "moduleResolution":    "node",
    "lib":                 ["ES2022"],
    "outDir":              "./dist",
    "rootDir":             "./",
    "strict":              true,
    "esModuleInterop":     true,
    "skipLibCheck":        true,
    "resolveJsonModule":   true,
    "forceConsistentCasingInFileNames": true,
    "declaration":         false,
    "sourceMap":           true
  },
  "include": ["server/**/*"],
  "exclude": ["node_modules", "dist", "ui"]
}
